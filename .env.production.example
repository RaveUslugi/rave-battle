# Domain pointing at this server (A/AAAA records); Caddy gets HTTPS certificates for it.
DOMAIN=rave.example.com
PUBLIC_URL=https://rave.example.com
POSTGRES_PASSWORD=change-me-long-random
NODE_ENV=production
DEV_LOGIN=0
SESSION_TTL_DAYS=30
# Discord application (https://discord.com/developers/applications), OAuth2 redirect:
#   https://rave.example.com/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: only members of this guild can play.
DISCORD_GUILD_ID=
# Comma-separated Discord user ids with access to /admin.
ADMIN_DISCORD_IDS=
