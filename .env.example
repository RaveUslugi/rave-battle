DATABASE_URL=postgres://rave:rave@localhost:54329/rave
TEST_DATABASE_URL=postgres://rave:rave@localhost:54329/rave_test
PORT=3000
PUBLIC_URL=http://localhost:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173
DEV_LOGIN=1
NODE_ENV=development

# Discord OAuth (required in production). Redirect URL to register in the Discord app:
#   <PUBLIC_URL origin>/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional: only members of this guild can play.
# Membership is checked at every Discord login and stored per user. Existing sessions keep their
# previous status until the next login (sessions last SESSION_TTL_DAYS), so changing
# DISCORD_GUILD_ID does not re-check users who are already logged in.
DISCORD_GUILD_ID=
