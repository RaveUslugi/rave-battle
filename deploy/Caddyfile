{
	# HTTP/1.1 and HTTP/2 only. With HTTP/3 advertised, a browser whose UDP 443 is blocked
	# anywhere on the way remembers it and fails with ERR_QUIC_PROTOCOL_ERROR.
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	@api path /trpc/* /ws /chunk/* /overview /auth/* /health
	handle @api {
		reverse_proxy server:3000
	}
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html /admin /admin/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
